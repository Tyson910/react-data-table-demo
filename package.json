{
  "name": "mano-benefits-mrf",
  "private": true,
  "scripts": {
    "dev:backend": "pnpm --filter ./backend dev",
    "dev:frontend": "pnpm --filter ./frontend dev",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter backend test",
    "lint": "oxlint --config oxlint.json . && pnpm fmt:check",
    "lint:fix": "oxlint --config oxlint.json --fix ."
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "tsconfck>typescript": "^7.0.2"
      }
    }
  },
  "devDependencies": {
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6"
  }
}
